{
  "name": "@pymeshub/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:cloud": "cross-env PYMESHUB_EDITION=cloud PYMESHUB_UPDATER_ACTIVE=true tauri dev --config src-tauri/tauri.cloud.conf.json",
    "tauri:build:cloud": "cross-env PYMESHUB_EDITION=cloud PYMESHUB_UPDATER_ACTIVE=true tauri build --config src-tauri/tauri.cloud.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wouter": "^3.10.0",
    "@tanstack/react-query": "^5.101.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
