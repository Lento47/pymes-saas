# App
NODE_ENV=production
PORT=4000
PYMESHUB_EDITION=enterprise
PYMESHUB_STORAGE_MODE=local
PYMESHUB_STORAGE_ROOT=C:\ProgramData\Pymeshub\data

# PostgreSQL
DATABASE_URL=postgresql://pymeshub:change-me@localhost:5432/pymeshub_enterprise?schema=public

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Redis (solo si el despliegue enterprise lo necesita)
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000
