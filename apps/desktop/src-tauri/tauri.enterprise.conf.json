{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pymeshub Enterprise",
  "version": "0.1.0",
  "identifier": "com.pymeshub.desktop.enterprise",
  "build": {
    "frontendDist": "../../web/dist/public",
    "devUrl": "http://127.0.0.1:5000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pymeshub Enterprise",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "enterprise"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/api"],
    "resources": {
      "binaries/libquery_engine-windows.dll.node": "./"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": ["es-ES"]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pymeshub"]
      }
    },
    "shell": {
      "open": true
    }
  }
}
