# Perfil del desktop: cloud o enterprise.
PYMESHUB_EDITION=cloud

# URL que cargará el shell desktop al compilar.
# Cloud: apunta al SaaS.
# Enterprise: apunta a la URL privada del cliente.
PYMESHUB_REMOTE_URL=http://127.0.0.1:5000

# Updater nativo: recomendado true para cloud y false para enterprise.
PYMESHUB_UPDATER_ACTIVE=true
