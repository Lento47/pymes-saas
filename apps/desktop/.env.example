# Perfil del desktop enterprise.
PYMESHUB_EDITION=enterprise

# URL que cargará el shell desktop al compilar.
# Debe apuntar al host local o LAN del servidor enterprise.
PYMESHUB_REMOTE_URL=http://127.0.0.1:5000

# Updater nativo: normalmente desactivado en enterprise.
PYMESHUB_UPDATER_ACTIVE=false
