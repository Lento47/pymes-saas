# Copiar a .env y ajustar si hace falta
# Puerto del front + proxy (Vite en modo middleware)
PORT=5000
# API Nest (pnpm start:dev en PYMES). 127.0.0.1 evita fallos de proxy con localhost/IPv6
API_PROXY_TARGET=http://127.0.0.1:4000

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Paddle — get these from your Paddle dashboard (sandbox or production)
VITE_PADDLE_CLIENT_TOKEN=test_your_client_token_here
VITE_PADDLE_ENVIRONMENT=sandbox

# Paddle Price IDs (from Paddle dashboard > Catalog > Prices)
VITE_PADDLE_PRICE_STARTER_MONTHLY=pri_
VITE_PADDLE_PRICE_GROWTH_MONTHLY=pri_
VITE_PADDLE_PRICE_ENTERPRISE_MONTHLY=pri_
