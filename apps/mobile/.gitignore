# Expo's own state: the dev server's manifest, the typed-routes union, the cache.
.expo/

# Generated by `expo start`/`expo prebuild`, and regenerated on every run — committing
# it means a stale reference types `expo/types` after an SDK bump.
expo-env.d.ts

# Prebuild output. The native projects are generated from `app.config.ts`, and the one
# thing they would carry into a commit is a signing configuration.
/android
/ios

# Export output (`expo export`).
/dist
