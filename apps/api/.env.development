# ─────────────────────────────────────────────────────────────────────────────
# .env.development — NestJS Multi-tenant SaaS
# Used by: docker-compose.yml + local `pnpm start:dev`
# DO NOT commit real secrets. Rotate all values before moving to staging/prod.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
# Host port 5433 maps to the pymes-pg container's 5432 (see docker-compose.yml)
DATABASE_URL=postgresql://pymes:pymes123@localhost:5433/saas_db?schema=public

# ── Authentication ────────────────────────────────────────────────────────────
# Minimum 32 characters — generate a strong value for every environment
JWT_SECRET=dev-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# ── Redis 7 ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Object Storage (MinIO — S3-compatible) ────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio123
STORAGE_BUCKET=pymes-documents

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5000,http://localhost:3000

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=pymes-api
# Jaeger / OTLP collector running locally (e.g. via docker run jaegertracing/all-in-one)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
