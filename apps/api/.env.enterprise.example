# Pymeshub Enterprise — Auto-generated during Windows installer startup
# DO NOT EDIT manually — changes will be overwritten

# App Configuration
NODE_ENV=production
PORT=4000
PYMESHUB_EDITION=enterprise
PYMESHUB_STORAGE_MODE=local
PYMESHUB_STORAGE_ROOT=C:\ProgramData\Pymeshub\data

# Database (SQLite for local/MSI deployments)
# Format: file:<path-to-db>
DATABASE_URL=file:C:/ProgramData/Pymeshub/data/pymeshub.db

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Redis (local instance or managed service)
REDIS_HOST=localhost
REDIS_PORT=6379

# Prisma Query Engine (Windows-specific paths for MSI bundle)
# These are set automatically during installer startup
PRISMA_QUERY_ENGINE_LIBRARY=C:\Program Files\Pymeshub Enterprise\enterprise-runtime\a\node_modules\prisma\node_modules\@prisma\engines\query_engine-windows.dll.node
PRISMA_SCHEMA_ENGINE_BINARY=C:\Program Files\Pymeshub Enterprise\enterprise-runtime\a\node_modules\prisma\node_modules\@prisma\engines\schema-engine-windows.exe

# CORS (for production and desktop app)
CORS_ORIGIN=https://pymeshub.lat,https://www.pymeshub.lat,tauri://localhost
