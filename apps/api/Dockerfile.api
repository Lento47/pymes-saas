# ─────────────────────────────────────────────
# Stage 1 — Builder
# ─────────────────────────────────────────────
# Build context: monorepo root (.)
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy monorepo manifests first for better layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy api package.json (needed for workspace dep resolution before install)
COPY apps/api/package.json ./apps/api/

# Install only api and its transitive workspace dependencies
RUN pnpm install --frozen-lockfile --filter saas-api...

# Copy the full api source
COPY apps/api/ ./apps/api/

# Generate Prisma client
RUN pnpm --filter saas-api exec prisma generate

# Compile TypeScript → dist/
RUN pnpm --filter saas-api run build

# Create a standalone production deployment with flat node_modules
# (installs only production dependencies into /standalone/node_modules)
RUN pnpm --filter saas-api deploy --prod /standalone
# dist/ is in .gitignore so pnpm deploy excludes it — copy manually
RUN cp -r /app/apps/api/dist /standalone/dist

# ─────────────────────────────────────────────
# Stage 2 — Runner
# ─────────────────────────────────────────────
FROM node:20-alpine AS runner

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Copy only the standalone deployment (flat node_modules + built output)
COPY --from=builder --chown=appuser:appgroup /standalone/node_modules ./node_modules
COPY --from=builder --chown=appuser:appgroup /standalone/package.json  ./package.json
COPY --from=builder --chown=appuser:appgroup /standalone/dist          ./dist
COPY --from=builder --chown=appuser:appgroup /standalone/prisma        ./prisma

USER appuser

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD wget -qO- http://localhost:4000/api/health || exit 1

CMD ["node", "dist/src/main"]
