# ─────────────────────────────────────────────────────────────────────────────
# .env.production.example — NestJS Multi-tenant SaaS
#
# INSTRUCTIONS
#   1. Copy this file to .env.production (never commit the real file).
#   2. Fill every placeholder marked with <REPLACE_...>.
#   3. Prefer injecting secrets through your platform's secret manager
#      (AWS Secrets Manager, Doppler, Fly.io secrets, Heroku Config Vars, etc.)
#      rather than writing them to a file on disk.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Port exposed by the container / process manager
PORT=4000

# ── Database (Managed PostgreSQL) ────────────────────────────────────────────
# Obtain from your cloud provider's dashboard:
#   AWS RDS / Aurora:       console.aws.amazon.com → RDS → Databases → Connectivity
#   Supabase:               app.supabase.com → Project → Settings → Database
#   Neon:                   console.neon.tech → Connection string
#   Railway:                railway.app → your project → PostgreSQL → Connect
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=<REPLACE_MANAGED_POSTGRES_URL>

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
# Store in your secret manager — never hardcode here.
JWT_SECRET=<REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS>
JWT_EXPIRES_IN=1d

# ── Redis (Managed Redis / Valkey) ───────────────────────────────────────────
# Obtain from:
#   Upstash:    console.upstash.com → Redis → Details
#   AWS ElastiCache: console.aws.amazon.com → ElastiCache → Clusters
#   Redis Cloud: app.redislabs.com
REDIS_HOST=<REPLACE_MANAGED_REDIS_HOST>
REDIS_PORT=6379
# Uncomment if your managed Redis requires a password:
# REDIS_PASSWORD=<REPLACE_REDIS_PASSWORD>
# Uncomment if TLS is required (most managed providers):
# REDIS_TLS=true

# ── Object Storage (AWS S3 native) ───────────────────────────────────────────
# In production, use AWS S3 directly instead of MinIO.
# Leave STORAGE_ENDPOINT empty so the AWS SDK resolves the standard endpoint.
# IAM: grant s3:GetObject, s3:PutObject, s3:DeleteObject on your bucket ARN.
STORAGE_ENDPOINT=
STORAGE_REGION=<REPLACE_AWS_REGION>          # e.g. us-east-1
STORAGE_ACCESS_KEY=<REPLACE_AWS_ACCESS_KEY_ID>
STORAGE_SECRET_KEY=<REPLACE_AWS_SECRET_ACCESS_KEY>
STORAGE_BUCKET=<REPLACE_S3_BUCKET_NAME>

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Example: https://app.mypymes.com
CORS_ORIGIN=<REPLACE_FRONTEND_URL>

# ── OpenAI Agent Builder ─────────────────────────────────────────────────────
# Workflow ID público del agente (texto plano, no encriptar)
OPENAI_AGENT_WORKFLOW_ID=<REPLACE_WORKFLOW_ID>

# ── MCP / API Tokens ──────────────────────────────────────────────────────────
# Generate tokens with:
#   node -e "console.log('pym_' + require('crypto').randomBytes(32).toString('hex'))"
# Founder: full CRUD access — pass to Agent Builder MCP Server auth
PYMESHUB_FOUNDER_API_KEY=<REPLACE_WITH_GENERATED_TOKEN>
# User: limited read+write access
PYMESHUB_USER_API_KEY=<REPLACE_WITH_GENERATED_TOKEN>
# Legacy master token (treats as founder)
PYMESHUB_MASTER_API_TOKEN=<REPLACE_WITH_GENERATED_TOKEN>
# Set to "true" to expose only 3 tools (get_workspace, list_contacts, get_stats)
PYMESHUB_MCP_COMPAT_MODE=false

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=pymes-api
# Point to your observability backend collector:
#   Grafana Cloud:  https://otlp-gateway-<zone>.grafana.net/otlp
#   Honeycomb:      https://api.honeycomb.io
#   Datadog:        https://api.datadoghq.com/api/intake/otlp/v1/traces
#   Self-hosted:    https://otel-collector.your-infra.internal:4317
OTEL_EXPORTER_OTLP_ENDPOINT=<REPLACE_OTEL_COLLECTOR_URL>
# Add your API key / header if required by the provider:
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<API_KEY>
