// ============================================================
// AGENT SUPPORT — Multi-agent support & escalation system
// ============================================================

enum AgentSessionStatus {
  ACTIVE
  COMPLETED
  ESCALATED
  EXPIRED
}

enum EscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model AgentSession {
  id            String             @id @default(cuid())
  workspace_id  String
  user_id       String?
  agent_type    String // "router", "docs", "onboarding", "inbox", "billing", "troubleshooting", "escalation"
  status        AgentSessionStatus @default(ACTIVE)
  metadata_json Json?              @db.JsonB // { plan, role, locale, page_context }

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspace   Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages    AgentMessage[]
  toolCalls   AgentToolCall[]
  escalations AgentEscalation[]

  @@index([workspace_id])
  @@index([user_id])
  @@index([status])
  @@index([workspace_id, created_at(sort: Desc)])
  @@map("agent_sessions")
}

model AgentMessage {
  id            String @id @default(cuid())
  session_id    String
  role          String // "user", "assistant", "system", "tool"
  content       String @db.Text
  metadata_json Json?  @db.JsonB // { tool_calls, citations, confidence }

  created_at DateTime @default(now())

  session AgentSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([session_id, created_at])
  @@map("agent_messages")
}

model AgentToolCall {
  id             String   @id @default(cuid())
  session_id     String
  agent_type     String // which sub-agent made the call
  tool_name      String
  input_json     Json     @db.JsonB
  output_json    Json?    @db.JsonB
  risk_level     String? // "low", "medium", "high", "critical"
  allowed        Boolean  @default(true)
  blocked_reason String?
  executed_at    DateTime @default(now())

  session AgentSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([tool_name])
  @@index([risk_level])
  @@map("agent_tool_calls")
}

model AgentEscalation {
  id              String           @id @default(cuid())
  session_id      String?
  workspace_id    String
  user_id         String?
  severity        Priority         @default(MEDIUM)
  summary         String           @db.Text
  evidence_json   Json?            @db.JsonB // { steps_attempted, error_messages, context }
  status          EscalationStatus @default(OPEN)
  resolved_by     String? // user_id of resolving agent
  resolution_note String?          @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  session AgentSession? @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([status])
  @@index([severity])
  @@index([workspace_id, status])
  @@map("agent_escalations")
}

// ============================================================
// SUPPORT DIAGNOSTIC — In-app diagnostic cases & known issues
// ============================================================

model SupportDiagnosticCase {
  id               String  @id @default(cuid())
  workspace_id     String
  user_id          String?
  module           String // "inbox", "billing", "settings", etc.
  error_code       String?
  trace_id         String?
  category         String // "USER_GUIDANCE", "PERMISSION_ISSUE", etc.
  risk_level       String // "low", "medium", "high", "critical"
  status           String  @default("OPEN") // "OPEN", "INVESTIGATING", "RESOLVED", "ESCALATED"
  title            String
  user_description String? @db.Text
  safe_summary     String? @db.Text
  steps_json       Json?   @db.JsonB // reproduction_steps
  evidence_json    Json?   @db.JsonB // collected evidence
  resolution_json  Json?   @db.JsonB // { resolution, workaround, escalated_to }

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspace Workspace            @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  fixCases  EngineeringFixCase[]

  @@index([workspace_id])
  @@index([error_code])
  @@index([category])
  @@index([status])
  @@index([workspace_id, created_at(sort: Desc)])
  @@map("support_diagnostic_cases")
}

model SupportKnownIssue {
  id                String  @id @default(cuid())
  error_code        String  @unique
  title             String
  module            String
  category          String
  severity          String // "low", "medium", "high", "critical"
  description       String? @db.Text
  workaround        String? @db.Text
  fix_status        String  @default("OPEN") // "OPEN", "FIX_IN_PROGRESS", "FIXED", "WONT_FIX"
  fix_pr_url        String?
  affected_versions String?
  fixed_in_version  String?
  is_active         Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([error_code])
  @@index([module])
  @@index([severity])
  @@index([fix_status])
  @@map("support_known_issues")
}

// ============================================================
// ENGINEERING FIX AGENT — Automated bug reproduction & PRs
// ============================================================

enum EngineeringFixStatus {
  PENDING
  INVESTIGATING
  FIX_READY
  PR_OPENED
  MERGED
  FAILED
}

model EngineeringFixCase {
  id                 String               @id @default(cuid())
  diagnostic_case_id String?
  branch_name        String?
  status             EngineeringFixStatus @default(PENDING)
  pr_url             String?
  pr_number          Int?
  files_changed_json Json?                @db.JsonB
  test_added_json    Json?                @db.JsonB
  fix_summary        String?              @db.Text
  rollback_notes     String?              @db.Text
  error_log          String?              @db.Text
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt

  diagnosticCase SupportDiagnosticCase? @relation(fields: [diagnostic_case_id], references: [id])

  @@index([status])
  @@index([diagnostic_case_id])
  @@map("engineering_fix_cases")
}

// ============================================================
// INVENTORY
// ============================================================

enum ProductType {
  PRODUCT
  SERVICE
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  REVERSAL
}

model ProductCategory {
  id           String   @id @default(cuid())
  workspace_id String
  name         String
  description  String?
  color        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([workspace_id, name])
  @@map("product_categories")
}

model Product {
  id              String      @id @default(cuid())
  workspace_id    String
  category_id     String?
  name            String
  sku             String
  description     String?     @db.Text
  type            ProductType @default(PRODUCT)
  unit_price      Decimal     @db.Decimal(12, 5)
  cost_price      Decimal?    @db.Decimal(12, 5)
  current_stock   Int         @default(0)
  min_stock       Int         @default(0)
  unit_of_measure String?
  track_inventory Boolean     @default(true)
  is_active       Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  category      ProductCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  workspace     Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  movements     StockMovement[]
  invoice_lines InvoiceLine[]

  @@unique([workspace_id, sku])
  @@index([workspace_id, is_active])
  @@index([workspace_id, current_stock])
  @@map("products")
}

model StockMovement {
  id             String       @id @default(cuid())
  workspace_id   String
  product_id     String
  type           MovementType
  quantity       Int
  previous_stock Int
  new_stock      Int
  reason         String?
  reference_type String?
  reference_id   String?
  user_id        String?
  created_at     DateTime     @default(now())

  product   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([product_id])
  @@index([workspace_id, created_at(sort: Desc)])
  @@map("stock_movements")
}
