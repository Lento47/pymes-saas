# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/saas_db?schema=public"

# JWT
JWT_SECRET="super-secret-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# App
PORT=4000
NODE_ENV=development
PYMESHUB_EDITION=enterprise
PYMESHUB_STORAGE_MODE=local
PYMESHUB_STORAGE_ROOT="C:\\ProgramData\\Pymeshub\\data"

# CORS — separar múltiples orígenes con coma
CORS_ORIGIN="http://localhost:3000"

# Transactional email (invitations, password resets) via Resend
RESEND_API_KEY="re_..."
SYSTEM_EMAIL_FROM="no-reply@pymeshub.app"
SYSTEM_EMAIL_FROM_NAME="Pymeshub"

# WhatsApp (Meta Cloud API)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="tu-token-de-verificacion-secreto"

# OpenAI (para análisis de conversaciones con IA)
OPENAI_API_KEY=sk-...
