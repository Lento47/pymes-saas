# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/saas_db?schema=public"

# JWT
JWT_SECRET="super-secret-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# App
PORT=4000
NODE_ENV=development

# CORS — separar múltiples orígenes con coma
CORS_ORIGIN="http://localhost:3000"

# WhatsApp (Meta Cloud API)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="tu-token-de-verificacion-secreto"

# OpenAI (para análisis de conversaciones con IA)
OPENAI_API_KEY=sk-...

# Paddle (billing)
PADDLE_API_KEY="your-paddle-api-key"
PADDLE_WEBHOOK_SECRET="your-paddle-webhook-secret"
PADDLE_ENVIRONMENT="sandbox"
# Paddle price IDs — map to plan tiers
PADDLE_PRICE_STARTER_MONTHLY="pri_..."
PADDLE_PRICE_STARTER_ANNUAL="pri_..."
PADDLE_PRICE_GROWTH_MONTHLY="pri_..."
PADDLE_PRICE_GROWTH_ANNUAL="pri_..."
PADDLE_PRICE_ENTERPRISE_MONTHLY="pri_..."
PADDLE_PRICE_ENTERPRISE_ANNUAL="pri_..."
