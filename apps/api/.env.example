# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/saas_db?schema=public"

# JWT
JWT_SECRET="super-secret-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# App
PORT=4000
NODE_ENV=development

# CORS — separar múltiples orígenes con coma
CORS_ORIGIN="http://localhost:3000"

# Transactional email (invitations, notifications) via Resend
RESEND_API_KEY="re_..."
RESEND_WEBHOOK_SECRET="whsec_..."
SYSTEM_EMAIL_FROM="noreply@pymeshub.lat"
SYSTEM_EMAIL_FROM_NAME="PymesHub"
# Encryption key for per-workspace email API keys (AES-256-GCM)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="change-me-to-a-random-32-byte-hex-string"

# OAuth — Google + Facebook social login
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."
FACEBOOK_APP_ID="..."
FACEBOOK_APP_SECRET="..."

# WhatsApp (Meta Cloud API)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="tu-token-de-verificacion-secreto"

# OpenAI (para análisis de conversaciones con IA)
OPENAI_API_KEY=sk-...
# OpenAI Agent Builder — ID público del workflow (no encriptar)
OPENAI_AGENT_WORKFLOW_ID=wf_...

# MCP / API Tokens (acceso programático para agentes)
PYMESHUB_FOUNDER_API_KEY=pym_...
PYMESHUB_USER_API_KEY=pym_...
PYMESHUB_MASTER_API_TOKEN=pym_...
PYMESHUB_MCP_COMPAT_MODE=false

# Paddle (billing / subscriptions)
PADDLE_API_KEY=sandbox_...
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=sandbox_...

# Cloudflare AI Gateway (multi-provider — reemplaza llamadas directas a providers)
CF_GATEWAY_ACCOUNT_ID=tu-account-id
CF_GATEWAY_ID=pymeshub
CF_GATEWAY_TOKEN=tu-cloudflare-ai-gateway-token
# Modelo default del sistema: "provider/model" — sin costo con workers-ai
SYSTEM_AI_MODEL=workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Claves por proveedor CF Gateway (opcionales — solo workers-ai funciona gratis sin claves)
GATEWAY_KEY_OPENAI=sk-...
GATEWAY_KEY_ANTHROPIC=sk-ant-...
GATEWAY_KEY_GOOGLE_AI_STUDIO=AIza...
GATEWAY_KEY_GROQ=gsk_...
GATEWAY_KEY_GROK=xai-...
GATEWAY_KEY_MISTRAL=...
GATEWAY_KEY_COHERE=...
GATEWAY_KEY_DEEPSEEK=...
GATEWAY_KEY_PERPLEXITY_AI=pplx-...
GATEWAY_KEY_CEREBRAS=...
