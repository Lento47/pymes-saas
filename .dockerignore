# ============================================================
# Docker ignore — Railway build context (project root)
# ============================================================

# Dependencies — reinstalled inside the container
node_modules
.pnpm-store

# Build artifacts — rebuilt inside the container
dist
build

# Environment files — never bake secrets into images
.env
.env.*
!.env.example
!.env.production.example

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# Version control
.git
.gitignore
.gitattributes

# Test & coverage artifacts
coverage
.nyc_output
__tests__
**/*.spec.ts
**/*.test.ts

# CI / tooling config (not needed at runtime)
.github
.husky
.eslintrc*
.prettierrc*
.editorconfig
jest.config.*
tsconfig.test.json

# OS artifacts
.DS_Store
Thumbs.db

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# Local IDE settings
.vscode
.idea

# ============================================================
# Platform split: Railway only needs apps/api + shared deps.
# Exclude apps/web entirely except package.json (needed for
# pnpm workspace resolution during install).
# ============================================================
apps/web/**
!apps/web/package.json
