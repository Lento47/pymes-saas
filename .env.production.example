# API Configuration
NODE_ENV=production
PORT=4000
API_URL=https://api.pymeshub.com

# Database
DATABASE_URL=postgresql://user:password@host:5432/pymeshub_prod

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=24h

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key

# WhatsApp Integration (Meta Cloud API)
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# AWS S3 / File Storage
AWS_S3_BUCKET=pymeshub-prod
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Optional: OpenTelemetry (if using observability)
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-endpoint.com
OTEL_API_KEY=your-otel-key

# Frontend URL (for CORS)
FRONTEND_URL=https://pymeshub.com
