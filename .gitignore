node_modules/
dist/
.env
*.log
.DS_Store
.enterprise-runtime-release/
.enterprise-runtime-bundle/
.codex-worktrees/
.worktrees/
# `git worktree add .wt-<name> <branch>` is the same thing as the two above and lands in
# the status list the same way. A worktree is a full checkout — including its own
# `node_modules` — so `git add -A` on a tree with one of these unignored commits an entire
# second copy of the repository. Two were already listed and this naming was not, which is
# why `.wt-brand` showed up as `??` while its siblings did not.
.wt-*/
.wrangler/
**/.wrangler/
.turbo/
**/.turbo/
apps/android/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/dist/

# Stale lockfiles — only the root pnpm-lock.yaml is authoritative in this pnpm
# workspace. Per-app and npm lockfiles are not used by CI/Docker and cause
# phantom Dependabot alerts, so keep them out of the tree.
package-lock.json
**/package-lock.json
apps/*/pnpm-lock.yaml

# Local mobile browser traces (screenshots for design review are kept separately).
.design-reference/test-results/

# Scratch files from an investigation session: `_scan*.py`, `_v*.txt`, `_w*.py`,
# `_h.txt`. They hardcode absolute paths into one developer's Downloads folder
# (`_scan.py` opens `C:/Users/<name>/Downloads/interface.md`) and are meaningless
# outside the session that wrote them. `**/` because the same debris was left in
# `apps/` and `apps/mobile/` too.
_*.py
_*.txt
**/_*.txt
