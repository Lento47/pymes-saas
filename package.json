{
  "name": "pymes-saas",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev:api": "pnpm --filter saas-api dev",
    "dev:web": "pnpm --filter rest-express dev",
    "dev:desktop": "pnpm --filter @pymeshub/desktop tauri:dev:cloud",
    "dev:desktop:cloud": "pnpm --filter @pymeshub/desktop tauri:dev:cloud",
    "build:api": "pnpm --filter saas-api build",
    "build:web": "pnpm --filter rest-express build",
    "build:desktop": "pnpm --filter @pymeshub/desktop tauri:build:cloud",
    "build:desktop:cloud": "pnpm --filter @pymeshub/desktop tauri:build:cloud",
    "test:api": "pnpm --filter saas-api test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/report",
    "catalog:images": "node scripts/category-images.mjs",
    "pilot:mobile:test": "node --test scripts/evaluate-mobile-pilot.test.mjs",
    "pilot:mobile:evaluate": "node scripts/evaluate-mobile-pilot.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.49.0",
    "@protomaps/basemaps": "^5.7.2",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "tesseract.js",
      "sharp",
      "bcrypt"
    ],
    "overrides": {
      "@protobufjs/utf8": ">=1.1.1",
      "ws": ">=8.20.1",
      "fast-xml-parser": ">=5.7.0",
      "fast-xml-builder": ">=1.1.7",
      "uuid@<11.1.1": "^11.1.1",
      "tmp": ">=0.2.6",
      "lodash": ">=4.18.0",
      "follow-redirects": ">=1.16.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@nestjs/core": ">=11.1.18",
      "ioredis": "5.11.0",
      "@opentelemetry/propagator-jaeger": "^2.9.0",
      "@opentelemetry/core": "^2.8.0",
      "@xmldom/xmldom": "^0.8.15",
      "axios": "^1.18.0",
      "browserslist": "^4.28.7",
      "deepmerge-ts": "^8.0.0",
      "engine.io": "^6.6.7",
      "fast-uri": "^3.1.6",
      "form-data": "^4.0.6",
      "hono": "^4.13.5",
      "http-proxy-middleware": "^4.1.1",
      "ip-address": "^10.3.1",
      "mysql2": "^3.23.1",
      "postcss": "^8.5.23",
      "protobufjs": "^8.6.6",
      "qs": "^6.16.0",
      "socket.io-parser": "^4.2.7",
      "undici": "^7.29.0",
      "@vitest/mocker": "^4.1.11",
      "baseline-browser-mapping": "^2.11.0",
      "decode-uri-component": "^0.5.0",
      "sanitize-html": "^2.17.7",
      "valibot": "^1.4.2",
      "vitest": "^4.1.11",
      "body-parser": "^2.3.0",
      "joi": "^18.2.5",
      "postcss-selector-parser": "^6.1.3",
      "brace-expansion@>=1.0.0 <2.0.0": "^1.1.18",
      "brace-expansion@>=2.0.0 <3.0.0": "^2.1.4",
      "brace-expansion@>=4.0.0": "^5.0.9",
      "js-yaml@>=3.0.0 <4.0.0": "^3.15.2",
      "js-yaml@>=4.0.0": "^4.3.2",
      "nanoid@>=3.0.0 <4.0.0": "^3.3.18",
      "nanoid@>=4.0.0": "^5.1.16",
      "vite@>=6.0.0 <7.0.0": "6.4.3",
      "vite@>=7.0.0": "^7.3.5",
      "@hono/node-server@>=1.0.0 <2.0.0": "^1.19.15",
      "@hono/node-server@>=2.0.0": "^2.0.10",
      "esbuild@<0.25.0": "^0.25.0",
      "esbuild@>=0.27.0": "^0.28.1",
      "multer": "^2.3.0"
    }
  }
}
